# Copie este archivo como .env y complete los valores. El .env no se versiona.

SECRET_KEY=genere-una-clave-larga-y-aleatoria
FLASK_DEBUG=0

# Cadena de conexion de Supabase (Project Settings > Database > Connection string)
DATABASE_URL=postgresql://usuario:clave@host:5432/postgres
DB_MAX_CONEXIONES=5

# Reconocimiento facial
UMBRAL_CONFIANZA=0.85
UMBRAL_DISTANCIA=0.60

# Deteccion de armas
MODELO_YOLO=modelos/yolov8n-armas.pt
UMBRAL_ARMA=0.70
