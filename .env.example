# Servidor de aplicacion
SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
FLASK_DEBUG=0

# Base de datos PostgreSQL (Supabase)
DATABASE_URL=postgresql://usuario:clave@host:5432/postgres
DB_MAX_CONEXIONES=5

# Reconocimiento facial
# Distancia euclidiana maxima para considerar que dos codificaciones son de
# la misma persona. 0.6 es el valor de referencia de dlib.
UMBRAL_DISTANCIA=0.60
# Segundos durante los cuales no se repite el evento de una misma persona.
VENTANA_ANTIREBOTE=30

# Deteccion de armas visibles
MODELO_YOLO=modelos/yolov8n-armas.pt
UMBRAL_ARMA=0.70
# Minutos sin atencion antes de escalar la alerta al administrador.
MINUTOS_ESCALAMIENTO=5

# Seguridad de las cuentas
MAX_INTENTOS_FALLIDOS=5

# Hardware minimo exigido por el RNF-14
RESOLUCION_MINIMA_ANCHO=1280
RESOLUCION_MINIMA_ALTO=720
LUX_MINIMO=200

# Solo para las pruebas de integracion
# TEST_DATABASE_URL=postgresql://usuario:clave@localhost:5432/faceguard_test
