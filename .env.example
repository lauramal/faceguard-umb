# Servidor de aplicacion
SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
FLASK_DEBUG=0
# desarrollo, pruebas o produccion
APP_ENV=desarrollo
# Horas que dura una sesion del panel
HORAS_SESION=8

# Base de datos PostgreSQL (Supabase)
DATABASE_URL=postgresql://usuario:clave@host:5432/postgres
DB_MAX_CONEXIONES=5

# Reconocimiento facial
# Distancia euclidiana maxima para considerar que dos codificaciones son de
# la misma persona. 0.6 es el valor de referencia de dlib.
UMBRAL_DISTANCIA=0.60
# Segundos durante los cuales no se repite el evento de una misma persona.
VENTANA_ANTIREBOTE=30
# Un ingreso sin salida mas viejo que esto se da por cerrado.
HORAS_JORNADA_MAXIMA=16

# Deteccion de armas visibles
MODELO_YOLO=modelos/yolov8n-armas.pt
UMBRAL_ARMA=0.70
# Minutos sin atencion antes de escalar la alerta al administrador.
MINUTOS_ESCALAMIENTO=5
# El servidor revisa solo cada tantos segundos si hay alertas que escalar.
ESCALAMIENTO_AUTOMATICO=1
SEGUNDOS_REVISION_ESCALAMIENTO=60
# Segundos en que una nueva deteccion del mismo tipo se suma a la alerta abierta.
VENTANA_ALERTA=120

# Evidencias: fotograma de cada alerta. Con Supabase se guardan en un bucket
# PRIVADO; sin estas variables, en la carpeta EVIDENCIAS_DIR del servidor.
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_KEY=
# SUPABASE_BUCKET=evidencias
EVIDENCIAS_DIR=evidencias

# Seguridad de las cuentas
MAX_INTENTOS_FALLIDOS=5

# Hardware minimo exigido por el RNF-14
RESOLUCION_MINIMA_ANCHO=1280
RESOLUCION_MINIMA_ALTO=720
LUX_MINIMO=200

# Solo para las pruebas. DEBE ser una base aparte: las pruebas la borran.
# El nombre tiene que contener "test" o "prueba".
# TEST_DATABASE_URL=postgresql://usuario:clave@localhost:5432/faceguard_test

# En la estacion de captura
# FACEGUARD_TOKEN=1.xxxxxxxxxxxx
